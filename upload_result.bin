    <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://ship.page/#website","name":"ship.page","alternateName":["ship page","shippage"],"url":"https://ship.page/","publisher":{"@id":"https://ship.page/#org"}},{"@type":"Organization","@id":"https://ship.page/#org","name":"Bitgate, Inc.","url":"https://ship.page/","logo":"https://ship.page/favicon.png"},{"@type":"SoftwareApplication","@id":"https://ship.page/#app","name":"ship.page","url":"https://ship.page/","applicationCategory":"DeveloperApplication","applicationSubCategory":"Static site hosting","operatingSystem":"Any","isAccessibleForFree":true,"description":"Free HTML and static site hosting with no signup: upload an HTML file (up to 10 MB), a ZIP (up to 25 MB) or a folder in the browser, or POST it to the API, and get a live link in seconds.","featureList":["Anonymous uploads with no account or card: HTML files up to 10 MB, ZIPs up to 25 MB and 100 files","Live HTTPS link on its own subdomain in seconds","REST API, MCP server, browser extension and GitHub Action","Pro: drops never expire, named URLs that redeploy in place, password protection, 100 MB ZIPs with 10000 files per request","Team: everything in Pro plus a vanity subdomain"],"publisher":{"@type":"Organization","name":"Bitgate, Inc.","url":"https://ship.page/"},"offers":[{"@type":"Offer","name":"Free","price":"0","priceCurrency":"USD","url":"https://ship.page/pricing","description":"No account, no card. HTML files up to 10 MB, ZIPs up to 25 MB and 100 files. Links live 30 days, 90 with a free account."},{"@type":"Offer","name":"Pro","price":"4","priceCurrency":"USD","url":"https://ship.page/pricing","description":"Drops never expire, named URLs that redeploy in place, password protection, 100 MB ZIPs, 10000 files per request, 120 deploys per minute, API keys.","priceSpecification":{"@type":"UnitPriceSpecification","price":"4","priceCurrency":"USD","billingDuration":1,"unitCode":"MON"}},{"@type":"Offer","name":"Team","price":"19","priceCurrency":"USD","url":"https://ship.page/pricing","description":"Everything in Pro plus your own vanity subdomain.","priceSpecification":{"@type":"UnitPriceSpecification","price":"19","priceCurrency":"USD","billingDuration":1,"unitCode":"MON"}}]},{"@type":"FAQPage","@id":"https://ship.page/#faq","mainEntity":[{"@type":"Question","name":"Who can see my drop?","acceptedAnswer":{"@type":"Answer","text":"Anyone with the link, and nobody without it: every URL carries ~47 bits of entropy, so guessing one is a one-in-120-trillion shot."}},{"@type":"Question","name":"How long do drops live?","acceptedAnswer":{"@type":"Answer","text":"Anonymous drops live 30 days, 90 with a free account, or shorter if you pass ?ttl=; paid drops live forever, or exactly as long as any TTL you choose."}},{"@type":"Question","name":"Can I update a drop?","acceptedAnswer":{"@type":"Answer","text":"Subscribers can redeploy a named drop (?name=...) and the URL keeps serving the new content. Anonymous drops can't be edited in place, but every anonymous deploy returns a one-time claim token; save it and you can attach the drop to your account from the dashboard later."}},{"@type":"Question","name":"What can't I host?","acceptedAnswer":{"@type":"Answer","text":"Nothing illegal or harmful: no malware, phishing or scams. Report anything bad with the report form at ship.page/report, or email abuse@bitgate.com for legal notices."}},{"@type":"Question","name":"Is there an API / CLI?","acceptedAnswer":{"@type":"Answer","text":"Yes, curl IS the product: everything on this page is a flag on POST /deploy, and there's a GitHub Action for CI. See the API docs at ship.page/docs and the GitHub Action at github.com/bitgate/ship-page-action."}},{"@type":"Question","name":"What happens when I cancel?","acceptedAnswer":{"@type":"Answer","text":"Existing drops keep serving exactly as they are; paid features simply stop applying to new deploys."}}]}]}</script>
