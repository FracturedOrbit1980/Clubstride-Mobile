    <script>
      // Sign-in links carry their token in the fragment; we park it before any tracker reads the URL
      (function () {
        var match = /^#ml=(spm_[a-z0-9]{32})$/.exec(location.hash);
        if (!match) return;
        window.__shipMagic = match[1];
        history.replaceState(history.state, "", location.pathname + location.search);
      })();
    </script>
