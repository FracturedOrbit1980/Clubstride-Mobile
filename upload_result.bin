nded-lg bg-surface-950 ring-1 ring-surface-800"><pre class="overflow-x-auto p-3 pr-12 font-mono text-xs leading-6 text-surface-200"><code><span class="text-surface-400">POST</span> /deploy<span class="text-brand-300">?name=pr-42</span></code></pre><button type="button" class="absolute right-2 top-2 inline-flex h-7 w-7 items-center justify-center rounded-full bg-surface-800/90 text-xs text-surface-200 transition-colors hover:bg-surface-700 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-950" aria-label="Copy snippet"><svg data-prefix="far" data-icon="clipboard" class="svg-inline--fa fa-clipboard" role="img" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M232 96l-80 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l80 0c13.3 0 24 10.7 24 24s-10.7 24-24 24zm0 48c37.1 0 67.6-28 71.6-64L320 80c8.8 0 16 7.2 16 16l0 352c0 8.8-7.2 16-16 16L64 464c-8.8 0-16-7.2-16-16L48 96c0-8.8 7.2-16 16-16l16.4 0c4 36 34.5 64 71.6 64l80 0zM291.9 32C279 12.7 257 0 232 0L152 0c-25 0-47 12.7-59.9 32L64 32C28.7 32 0 60.7 0 96L0 448c0 35.3 28.7 64 64 64l256 0c35.3 0 64-28.7 64-64l0-352c0-35.3-28.7-64-64-64l-28.1 0z"></path></svg></button></div></div><div id="feat-vanity" class="flex flex-col gap-4 rounded-xl bg-white p-6 shadow-sm ring-1 ring-surface-200 transition-shadow hover:ring-surface-900 focus-within:ring-surface-900 lg:col-span-3"><div class="flex items-start justify-between gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-700" aria-hidden="true"><svg data-prefix="fas" data-icon="crown" class="svg-inline--fa fa-crown" role="img" viewBox="0 0 576 512" aria-hidden="true"><path fill="currentColor" d="M313 87.2c9.2-7.3 15-18.6 15-31.2 0-22.1-17.9-40-40-40s-40 17.9-40 40c0 12.6 5.9 23.9 15 31.2L194.6 194.8c-10 15.7-31.3 19.6-46.2 8.4L88.9 158.7c4.5-6.4 7.1-14.3 7.1-22.7 0-22.1-17.9-40-40-40s-40 17.9-40 40c0 21.8 17.5 39.6 39.2