="round"><path d="M4 12.15V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2h-3.35"></path><path d="M14 2v5a1 1 0 0 0 1 1h5m-15 8-3 3 3 3m4 0 3-3-3-3"></path></svg><span>.html</span></span><span class="upload-file-spark"><svg data-prefix="far" data-icon="arrow-up-right" class="svg-inline--fa fa-arrow-up-right" role="img" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M360 64c13.3 0 24 10.7 24 24l0 240c0 13.3-10.7 24-24 24s-24-10.7-24-24l0-182.1-295 295c-9.4 9.4-24.6 9.4-33.9 0S-2.3 416.4 7 407l295-295-182.1 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l240 0z"></path></svg></span></div><div class="upload-workbench-copy"><h3>A file. A folder. A fresh start.</h3><p>Your static site, one link away.</p><div class="upload-workbench-actions"><button type="button" class="upload-workbench-primary ship-uploader-browse"><svg data-prefix="far" data-icon="plus" class="svg-inline--fa fa-plus" role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M248 56c0-13.3-10.7-24-24-24s-24 10.7-24 24l0 176-176 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l176 0 0 176c0 13.3 10.7 24 24 24s24-10.7 24-24l0-176 176 0c13.3 0 24-10.7 24-24s-10.7-24-24-24l-176 0 0-176z"></path></svg>Choose files</button><select aria-label="Upload format"><option value="files" selected="">HTML / ZIP</option><option value="folder">Folder</option></select></div></div></div><div class="upload-workbench-foot"><span><svg data-prefix="far" data-icon="shield-check" class="svg-inline--fa fa-shield-check" role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256.1 0c4.6 0 9.2 1 13.3 2.9L457.8 82.8c22 9.3 38.4 31 38.3 57.2-.5 99.2-41.3 280.7-213.6 363.2-16.7 8-36.1 8-52.8 0-172.4-82.5-213.2-263.9-213.7-363.2-.1-26.2 16.3-47.9 38.3-57.2L242.7 2.9C246.8 1 251.4 0 256.1 0zM73.1 127c-5.9 2.5-9.1 7.7-9 12.7 .5 91.4 38.4 249.3 186.4 320.1 3.6 1.7 7.8 1.7 11.3 0 148-70.8 185.9-228.7 186.3-320.1 0-5-3.1-10.2-9-12.7l-183-77.6-183 77.6zm240.3 34.9c7.8-10.7 22.8-13.1 33.5-5.3 10.7 7.8 13.1 22.8 5.3 33.5L249.8 330.9c-4.2 5.7-10.7 9.3-17.8 9.8s-14-2.2-18.9-7.3l-46.4-48c-9.2-9.5-9-24.7 .6-33.9 9.5-9.2 24.7-8.9 33.9 .6l26.5 27.4 85.6-117.7z"></path></svg>No account needed</span><button type="button">Try a sample drop<!-- --> <svg data-prefix="far" data-icon="arrow-right" class="svg-inline--fa fa-arrow-right rtl:-scale-x-100" role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M505 273c9.4-9.4 9.4-24.6 0-33.9L337 71c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9l127 127-406.1 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l406.1 0-127 127c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L505 273z"></path></svg></button></div></div><dialog aria-labelledby="_R_brid_" class="ship-upload-dialog fixed inset-0 mx-auto mb-auto mt-4 w-[calc(100%_-_2rem)] max-w-md overflow-y-auto overscroll-contain rounded-2xl border border-surface-200 bg-white p-5 text-start text-surface-950 shadow-2xl backdrop:bg-scrim/60 sm:my-auto sm:p-6"><div class="ship-upload-dialog-head mb-5 flex items-start justify-between gap-3"><h2 id="_R_brid_" tabindex="-1" class="min-w-0 text-xl font-bold tracking-tight outline-none">Shipping…</h2><button type="button" aria-label="Close upload dialog" class="-me-2 -mt-2 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-surface-600 hover:bg-surface-100 hover:text-surface-950 disabled:cursor-wait disabled:opacity-30"><svg data-prefix="fas" data-icon="xmark" class="svg-inline--fa fa-xmark" role="img" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M55.1 73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L147.2 256 9.9 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192.5 301.3 329.9 438.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.8 256 375.1 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192.5 210.7 55.1 73.4z"></path></svg></button></div><p class="sr-only" aria-live="polite"></p></dialog><p class="sr-only" aria-live="polite"></p></div></div><div class="cur-hero-caption"><span>Static HTML</span><span class="cur-caption-line" aria-hidden="true"></span><span>ZIP builds</span><span class="cur-caption-line" aria-hidden="true"></span><span>Whole folders</span></div><a href="#how-it-works" class="cur-down-link" aria-label="See how ship.page works"><svg data-prefix="fas" data-icon="arrow-down" class="svg-inline--fa fa-arrow-down" role="img" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M169.4 502.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 402.7 224 32c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 370.7-105.4-105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z"></path></svg></a></div></section><section id="how-it-works" class="cur-how cur-container" aria-labelledby="hiw-title"><div class="cur-section-heading"><div><p class="cur-overline">A SHORTER PATH TO PUBLISHED</p><h2 id="hiw-title">Keep your flow.<br/>Skip the setup.</h2></div><p>Finished a prototype? Exported a report?<br/> Get it off your computer and into the conversation.</p></div><div id="hiw-steps" class="cur-story-grid"><article id="step-1" class="folio-card cur-story cur-story-files"><div class="folio-card__heading"><span class="cur-story-number">01 / UPLOAD</span></div><div class="folio-card__specimen"><svg class="cur-story-art" viewBox="0 0 400 340" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id="_R_j3d_-paper" x1="130" y1="20" x2="315" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#f5f8ff"></stop><stop offset=".48" stop-color="#bdcff9"></stop><stop offset="1" stop-color="#6485cd"></stop></linearGradient><linearGradient id="_R_j3d_-edge" x1="100" y1="20" x2="350" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#d4e2ff"></stop><stop offset=".5" stop-color="#7499f4"></stop><stop offset="1" stop-color="#264fc5"></stop></linearGradient><radialGradient id="_R_j3d_-sphere" cx=".32" cy=".26" r=".8"><stop stop-color="#e3ecff"></stop><stop offset=".5" stop-color="#aac2f2"></stop><stop offset="1" stop-color="#4469b1"></stop></radialGradient></defs><path d="M-80 172C72 54 255 66 464 216M-80 188C72 70 255 82 464 232M-80 204C72 86 255 98 464 248" stroke="#5679bd" stroke-opacity=".32"></path><g transform="translate(228 119) rotate(-25) skewY(9)"><rect x="-80" y="-78" width="135" height="158" rx="10" fill="#172d56" stroke="#5b7cb6" transform="translate(-28 27)"></rect><rect x="-80" y="-78" width="135" height="158" rx="10" fill="#294b83" stroke="#819dce" transform="translate(-14 14)"></rect><rect x="-80" y="-78" width="135" height="158" rx="10" fill="url(#_R_j3d_-paper)" stroke="#e6eeff"></rect><path d="M-59-52H34M-59-40H0" stroke="#526f9d" stroke-width="3" stroke-linecap="round"></path><rect x="-59" y="-18" width="93" height="50" rx="4" fill="#6384c1" fill-opacity=".32"></rect><path d="m-24-4-12 11 12 11m21-22 12 11-12 11m-9-25-7 28" stroke="#254e9c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M-59 47H13M-59 59H-13" stroke="#5d7eb4" stroke-width="3" stroke-linecap="round"></path></g></svg></div><div class="folio-card__caption"><h3>Bring what you made.</h3><p>An HTML file, a ZIP, or a static folder. No build settings to untangle.</p></div></article><article id="step-2" class="folio-card folio-card--emphasis cur-story cur-story-publish"><div class="folio-card__heading"><span class="cur-story-number">02 / PUBLISH</span></div><div class="folio-card__specimen"><svg class="cur-story-art" viewBox="0 0 400 340" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id="_R_l3d_-paper" x1="130" y1="20" x2="315" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#f5f8ff"></stop><stop offset=".48" stop-color="#bdcff9"></stop><stop offset="1" stop-color="#6485cd"></stop></linearGradient><linearGradient id="_R_l3d_-edge" x1="100" y1="20" x2="350" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#d4e2ff"></stop><stop offset=".5" stop-color="#7499f4"></stop><stop offset="1" stop-color="#264fc5"></stop></linearGradient><radialGradient id="_R_l3d_-sphere" cx=".32" cy=".26" r=".8"><stop stop-color="#e3ecff"></stop><stop offset=".5" stop-color="#aac2f2"></stop><stop offset="1" stop-color="#4469b1"></stop></radialGradient></defs><g transform="translate(260 94) rotate(-32)"><ellipse rx="144" ry="100.8" stroke="url(#_R_l3d_-edge)" stroke-width="13"></ellipse><ellipse rx="118" ry="82.6" stroke="url(#_R_l3d_-edge)" stroke-width="13"></ellipse><ellipse rx="92" ry="64.39999999999999" stroke="url(#_R_l3d_-edge)" stroke-width="13"></ellipse><ellipse rx="66" ry="46.199999999999996" stroke="url(#_R_l3d_-edge)" stroke-width="13"></ellipse><ellipse rx="38" ry="26" fill="#153896" stroke="#93b4ff" stroke-width="2"></ellipse></g><path d="M59 276 254 97M213 91 261 91 261 139" stroke="#e4eeff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M-34 310 161 131M5 327 177 170" stroke="#8aafff" stroke-opacity=".36"></path><circle cx="148" cy="194" r="5" fill="#fff"></circle></svg></div><div class="folio-card__caption"><h3>From local to live.</h3><p>Upload in your browser or send one API request. Your own URL comes back.</p></div></article><article id="step-3" class="folio-card cur-story cur-story-share"><div class="folio-card__heading"><span class="cur-story-number">03 / SHARE</span></div><div class="folio-card__specimen"><svg class="cur-story-art" viewBox="0 0 400 340" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id="_R_n3d_-paper" x1="130" y1="20" x2="315" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#f5f8ff"></stop><stop offset=".48" stop-color="#bdcff9"></stop><stop offset="1" stop-color="#6485cd"></stop></linearGradient><linearGradient id="_R_n3d_-edge" x1="100" y1="20" x2="350" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#d4e2ff"></stop><stop offset=".5" stop-color="#7499f4"></stop><stop offset="1" stop-color="#264fc5"></stop></linearGradient><radialGradient id="_R_n3d_-sphere" cx=".32" cy=".26" r=".8"><stop stop-color="#e3ecff"></stop><stop offset=".5" stop-color="#aac2f2"></stop><stop offset="1" stop-color="#4469b1"></stop></radialGradient></defs><g transform="translate(253 104) rotate(-22)"><circle r="91" fill="url(#_R_n3d_-sphere)"></circle><g stroke="#4667a2" stroke-opacity=".65"><circle r="91"></circle><ellipse rx="32" ry="91"></ellipse><ellipse rx="65" ry="91"></ellipse><ellipse rx="91" ry="32"></ellipse><ellipse rx="78" ry="61"></ellipse><path d="M-91 0H91M0-91V91"></path></g><ellipse rx="159" ry="45" transform="rotate(-24)" stroke="#5b7db6" stroke-width="1.2"></ellipse><ellipse rx="173" ry="57" transform="rotate(-24)" stroke="#6c8dc5" stroke-opacity=".5"></ellipse><circle cx="-132" cy="66" r="7" fill="#264fc5" stroke="#d9e5ff" stroke-width="3"></circle><circle cx="144" cy="-42" r="4" fill="#264fc5"></circle></g></svg></div><div class="folio-card__caption"><h3>Let the link do the work.</h3><p>Send the preview, share the report, move the project forward.</p></div></article></div></section><section class="cur-api-playground cur-container" id="cur-api" aria-labelledby="_R_4d_-heading"><div class="cur-api-intro"><p class="cur-overline">BUILT FOR YOUR WORKFLOW</p><h2 id="_R_4d_-heading">Your next deploy.<br/><span>One request away.</span></h2><p>POST HTML or a ZIP from your terminal, script, or AI tool. Get a live URL back.</p><a class="cur-button" href="/docs/deploy"><svg data-prefix="fas" data-icon="book-open" class="svg-inline--fa fa-book-open" role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 141.3l0 309.3 .5-.2C311.1 427.7 369.7 416 428.8 416l19.2 0 0-320-19.2 0c-42.2 0-84.1 8.4-123.1 24.6-16.8 7-33.4 13.9-49.7 20.7zM230.9 61.5L256 72 281.1 61.5C327.9 42 378.1 32 428.8 32L464 32c26.5 0 48 21.5 48 48l0 352c0 26.5-21.5 48-48 48l-35.2 0c-50.7 0-100.9 10-147.7 29.5l-12.8 5.3c-7.9 3.3-16.7 3.3-24.6 0l-12.8-5.3C184.1 490 133.9 480 83.2 480L48 480c-26.5 0-48-21.5-48-48L0 80C0 53.5 21.5 32 48 32l35.2 0c50.7 0 100.9 10 147.7 29.5z"></path></svg> API documentation<!-- --> <svg data-prefix="fas" data-icon="arrow-up-right" class="svg-inline--fa fa-arrow-up-right" role="img" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M384 96c0-17.7-14.3-32-32-32L128 64c-17.7 0-32 14.3-32 32s14.3 32 32 32L274.7 128 9.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L320 173.3 320 320c0 17.7 14.3 32 32 32s32-14.3 32-32l0-224z"></path></svg></a><a class="cur-text-link" href="/docs/quickstart">Follow the quickstart<!-- --> <svg data-prefix="fas" data-icon="arrow-up-right" class="svg-inline--fa fa-arrow-up-right" role="img" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M384 96c0-17.7-14.3-32-32-32L128 64c-17.7 0-32 14.3-32 32s14.3 32 32 32L274.7 128 9.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L320 173.3 320 320c0 17.7 14.3 32 32 32s32-14.3 32-32l0-224z"></path></svg></a></div><div class="cur-api-stage"><div class="cur-api-console"><div class="cur-console-title"><svg data-prefix="fas" data-icon="terminal" class="svg-inline--fa fa-terminal" role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M9.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L146.7 256 9.4 118.6zM224 384l256 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-256 0c-17.7 0-32-14.3-32-32s14.3-32 32-32z"></path></svg><span>POST</span><code>/deploy</code><span>No API key needed</span></div><div class="cur-example-tabs" role="tablist" aria-label="API examples"><button type="button" role="tab" id="_R_4d_-tab-0" aria-controls="_R_4d_-panel-0" aria-selected="true" tabindex="0">HTML</button><button type="button" role="tab" id="_R_4d_-tab-1" aria-controls="_R_4d_-panel-1" aria-selected="false" tabindex="-1">ZIP</button><button type="button" role="tab" id="_R_4d_-tab-2" aria-controls="_R_4d_-panel-2" aria-selected="false" tabindex="-1">JavaScript</button></div><div role="tabpanel" id="_R_4d_-panel-0" aria-labelledby="_R_4d_-tab-0"><div class="cur-example-caption"><span>Publish a single HTML file.</span><button type="button" aria-label="Copy HTML example"><svg data-prefix="fas" data-icon="copy" class="svg-inline--fa fa-copy" role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M192 0c-35.3 0-64 28.7-64 64l0 256c0 35.3 28.7 64 64 64l192 0c35.3 0 64-28.7 64-64l0-200.6c0-17.4-7.1-34.1-19.7-46.2L370.6 17.8C358.7 6.4 342.8 0 326.3 0L192 0zM64 128c-35.3 0-64 28.7-64 64L0 448c0 35.3 28.7 64 64 64l192 0c35.3 0 64-28.7 64-64l0-16-64 0 0 16-192 0 0-256 16 0 0-64-16 0z"></path></svg>Copy</button></div><pre class="cur-example-code" tabindex="0" aria-label="cURL code"><code><span class="cur-token-keyword">curl</span> https://ship.page/deploy \
  -H <span class="cur-token-string">&quot;Content-Type: text/html&quot;</span> \
  --data-binary @index.html</code></pre></div><div role="tabpanel" id="_R_4d_-panel-1" aria-labelledby="_R_4d_-tab-1" hidden=""></div><div role="tabpanel" id="_R_4d_-panel-2" aria-labelledby="_R_4d_-tab-2" hidden=""></div><div class="cur-api-response"><span><svg data-prefix="fas" data-icon="check" class="svg-inline--fa fa-check" role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M434.8 70.1c14.3 10.4 17.5 30.4 7.1 44.7l-256 352c-5.5 7.6-14 12.3-23.4 13.1s-18.5-2.7-25.1-9.3l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l101.5 101.5 234-321.7c10.4-14.3 30.4-17.5 44.7-7.1z"></path></svg>Live URL<span>Example response</span></span><code><span>url</span> https://your-drop.shipped.run/</code></div></div></div></section><section id="pricing" class="cur-pricing cur-container" aria-labelledby="pricing-title"><div class="cur-pricing-heading"><p class="cur-overline">SMALL PRICE. OPEN POSSIBILITIES.</p><h2 id="pricing-title">Free to ship. Cheap to keep.</h2><p>Deploys are anonymous on every plan — pay only when you want drops that stick around.</p></div><div id="pricing-grid" class="cur-pricing-grid"><article id="plan-free" class="cur-plan-card cur-tier-free "><div class="cur-plan-title"><h3>Free</h3></div><div class="cur-plan-offer"><p class="cur-price">$<!-- -->0<span>forever</span></p><span class="cur-tier-artwork" aria-hidden="true"><svg viewBox="0 0 164 140" fill="none" focusable="false"><defs><linearGradient id="_R_955d_-paper" x1="35" y1="20" x2="128" y2="122" gradientUnits="userSpaceOnUse"><stop stop-color="#f5f8ff"></stop><stop offset="1" stop-color="#a8c1f2"></stop></linearGradient><linearGradient id="_R_955d_-edge" x1="40" y1="30" x2="140" y2="126" gradientUnits="userSpaceOnUse"><stop stop-color="#99b6f3"></stop><stop offset="1" stop-color="#355da9"></stop></linearGradient></defs><ellipse cx="87" cy="120" rx="55" ry="10" fill="#071b41" fill-opacity=".12"></ellipse><path d="M13 98c30 20 95 14 137-12M8 108c43 22 104 12 146-12" strok