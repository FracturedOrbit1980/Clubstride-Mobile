-32 32-32l384 0c17.7 0 32 14.3 32 32z"></path></svg></button></div></div></header><main id="main" class="current-landing"><section id="hero" class="cur-hero"><svg data-playing="false" class="cur-orbit" viewBox="0 0 1440 780" fill="none" aria-hidden="true"><defs><linearGradient id="_R_id_-line" x1="80" y1="110" x2="1280" y2="710" gradientUnits="userSpaceOnUse"><stop stop-color="#264FC5" stop-opacity="0"></stop><stop offset=".22" stop-color="#264FC5"></stop><stop offset=".51" stop-color="var(--cur-art-line, #8FACFF)"></stop><stop offset=".77" stop-color="#264FC5"></stop><stop offset="1" stop-color="#264FC5" stop-opacity="0"></stop></linearGradient><linearGradient id="_R_id_-ribbon" x1="480" y1="0" x2="1030" y2="740" gradientUnits="userSpaceOnUse"><stop stop-color="var(--cur-art-ribbon, #0B152B)"></stop><stop offset=".55" stop-color="var(--cur-art-ribbon-mid, #172A50)"></stop><stop offset="1" stop-color="var(--cur-art-ribbon, #0B152B)"></stop></linearGradient></defs><path d="M-250 650C140 730 477 573 392 374C310 184 118 134 166 52C248-90 667 57 889 149C1295 317 1518 274 1660 68" stroke="var(--cur-art-orbit, #132241)" stroke-width="1"></path><path d="M-240 679C200 725 450 570 356 367C269 179 105 126 177 54C263-32 650 95 869 194C1203 345 1450 313 1690 152L1665 178C1436 339 1201 373 863 221C638 121 265-15 190 72C138 132 290 186 375 374C469 581 192 742-240 695Z" fill="url(#_R_id_-ribbon)"></path><path d="M-240 679C200 725 450 570 356 367C269 179 105 126 177 54C263-32 650 95 869 194C1203 345 1450 313 1690 152" stroke="url(#_R_id_-line)" stroke-width="1.4"></path><path d="M-230 697C183 744 471 583 375 374C290 186 138 132 190 72C265-15 638 121 863 221C1201 373 1436 339 1665 178" stroke="var(--cur-art-edge, #243963)" stroke-width=".8"></path><path d="M1680 778C1290 851 1011 647 1097 465C1180 289 1345 236 1291 152C1208 23 808 131 573 242C243 398-60 327-191 242" stroke="var(--cur-art-orbit, #1A2D51)" stroke-width="1"></path><path d="M1640 775C1283 794 1037 638 1131 444C1214 273 1362 233 1287 161C1207 84 830 184 595 286C252 436-41 390-212 283L-226 301C-47 416 261 458 609 310C845 209 1212 106 1269 181C1322 250 1196 284 1114 456C1024 647 1273 813 1640 791Z" fill="url(#_R_id_-ribbon)"></path><path d="M1640 775C1283 794 1037 638 1131 444C1214 273 1362 233 1287 161C1207 84 830 184 595 286C252 436-41 390-212 283" stroke="url(#_R_id_-line)" stroke-width="1.3"></path><circle cx="360" cy="375" r="4" fill="var(--cur-art-node, #9EB6FA)"></circle><circle cx="1132" cy="444" r="4" fill="var(--cur-art-node, #829FEF)"></circle></svg><div class="cur-hero-content cur-container"><p class="cur-overline"><span class="cur-blue-dot" aria-hidden="true"></span>FREE HTML HOSTING. NO SIGNUP.</p><h1>Good work deserves<br/><span>a live link.</span></h1><p class="cur-hero-description">Upload an HTML file up to 10 MB, a ZIP up to 25 MB or a whole folder and get a live link in seconds.<br class="cur-desktop-break"/> No account, no credit card.</p><h2 class="sr-only">Try it live</h2><div class="cur-hero-workbench"><div id="uploader" tabindex="0" aria-label="Ship zone — drag in an HTML file, a zip, or a folder; press Enter to browse for files" class="ship-uploader ship-uploader-hero ship-uploader-workbench relative flex min-w-0 max-w-full flex-col justify-center text-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50 border-solid border-surface-300 bg-white"><input type="file" accept=".html,.zip,text/html,application/zip" class="hidden" aria-hidden="true" tabindex="-1"/><input type="file" multiple="" class="hidden" aria-hidden="true" tabindex="-1"/><div class="upload-workbench"><div class="upload-workbench-head"><div class="upload-workbench-tabs" role="group" aria-label="Deployment method"><button type="button" aria-pressed="true"><svg data-prefix="far" data-icon="upload" class="svg-inline--fa fa-upload" role="img" viewBox="0 0 448 512" aria-hidden="true"><pat